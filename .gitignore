# ==========================================
# 🔒 1. 核心隐私与安全（绝对禁止上传）
# ==========================================
.env
.env.*
!.env.example

# 本地数据库文件
*.db
*.sqlite3
knowledge.db

# 个人配置备份/备忘录
config_note.txt
Client/lib/config.dart

# ==========================================
# 🐍 2. Python 后端忽略规则 (Server/)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
.pytest_cache/

# ==========================================
# 📱 3. Flutter/Dart 前端忽略规则 (Client/)
# ==========================================
# 编译产物
**/build/
**/.dart_tool/
**/doc/api/
**/ios/Flutter/.last_build_id
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/coverage/

# 安卓编译产物
/android/app/debug
/android/app/profile
/android/app/release

# 符号化与混淆文件
app.*.symbols
app.*.map.json
.widget_preview/

# ==========================================
# 🛠️ 4. IDE 与系统文件
# ==========================================
